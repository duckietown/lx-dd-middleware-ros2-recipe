# syntax=docker/dockerfile:1.4
# parameters
ARG EXERCISE_NAME="lx-dd-middleware-ros2"
ARG DESCRIPTION="VSCode - DD24 ROS2 Middleware"
ARG MAINTAINER="Duckietown"

# ==================================================>
# ==> Do not change the code below this line
ARG ARCH
ARG DISTRO=ente
ARG DOCKER_REGISTRY=docker.io
ARG BASE_IMAGE=dt-vscode
ARG BASE_TAG=${DISTRO}-${ARCH}
ARG LAUNCHER=default

# define base image
FROM ${DOCKER_REGISTRY}/duckietown/${BASE_IMAGE}:${BASE_TAG} as base

# recall all arguments
ARG DISTRO
ARG EXERCISE_NAME
ARG DESCRIPTION
ARG MAINTAINER
ARG BASE_TAG
ARG BASE_IMAGE
ARG LAUNCHER
# - buildkit
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT

# check build arguments
RUN dt-build-env-check "${EXERCISE_NAME}" "${MAINTAINER}" "${DESCRIPTION}"

# define/create repository path
ARG REPO_PATH="${SOURCE_DIR}/${EXERCISE_NAME}"
RUN mkdir -p "${REPO_PATH}"
WORKDIR "${REPO_PATH}"

# make code-server open the LX folder by default
ENV VSCODE_PATH="${REPO_PATH}" \
    ROS2_DISTRO=jazzy \
    COLCON_WS=/code \
    ROS_DOMAIN_ID=42 \
    LANG=C.UTF-8

# install apt dependencies
ARG ROS_APT_SOURCE_VERSION=1.3.0
ARG ROS_APT_SOURCE_SHA256=f31d84adf5054c7d60ded0e82c0f776a77ea33af53d08f40b9ad7c94cca55296
RUN . /etc/os-release && \
    test "${VERSION_CODENAME}" = noble && \
    curl --fail --location --silent --show-error \
        "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.${VERSION_CODENAME}_all.deb" \
        --output /tmp/ros2-apt-source.deb && \
    echo "${ROS_APT_SOURCE_SHA256}  /tmp/ros2-apt-source.deb" | sha256sum --check - && \
    dpkg --install /tmp/ros2-apt-source.deb && \
    rm /tmp/ros2-apt-source.deb
COPY --from=recipe ./dependencies-apt.vscode.txt "/tmp/"
RUN dt-apt-install /tmp/dependencies-apt.vscode.txt

# install python3 dependencies
ARG PIP_INDEX_URL="https://pypi.org/simple"
ENV PIP_INDEX_URL=${PIP_INDEX_URL}
COPY --from=recipe ./dependencies-py3.* "/tmp/"
RUN python3 -m pip install -r /tmp/dependencies-py3.txt

# copy the source code (recipe)
COPY --from=recipe ./packages "${REPO_PATH}/packages"

# store module metadata
LABEL org.duckietown.label.module.type="exercise-vscode" \
    org.duckietown.label.module.name="${EXERCISE_NAME}" \
    org.duckietown.label.module.description="${DESCRIPTION}" \
    org.duckietown.label.platform.os="${TARGETOS}" \
    org.duckietown.label.platform.architecture="${TARGETARCH}" \
    org.duckietown.label.platform.variant="${TARGETVARIANT}" \
    org.duckietown.label.code.location="ND" \
    org.duckietown.label.code.version.distro="${DISTRO}" \
    org.duckietown.label.base.image="${BASE_IMAGE}" \
    org.duckietown.label.base.tag="${BASE_TAG}" \
    org.duckietown.label.maintainer="${MAINTAINER}"
# <== Do not change the code above this line
# <==================================================

# setup vscode
COPY --from=recipe assets/vscode/setup.sh /tmp/vscode_setup.sh
RUN chmod +x /tmp/vscode_setup.sh && /tmp/vscode_setup.sh

# Prepare generated workspace output for the user chosen by dt-vscode at runtime.
COPY --from=recipe assets/vscode/launch.sh /usr/local/bin/dt-launcher-ros2-vscode
RUN chmod +x /usr/local/bin/dt-launcher-ros2-vscode
ENV DT_LAUNCHER=ros2-vscode
